---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'The Twenty-Two-Factor App — ten durable foundations and twelve modern operating principles for software that has to survive the real world.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="The Twenty-Two-Factor App" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Twenty-Two-Factor App home">
          <span class="wordmark-mark" aria-hidden="true"><b>22</b><i>/F</i></span>
          <span class="wordmark-copy">Twenty-Two<br />Factor App</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href={isHome ? '#factors' : '/#factors'}>Factors</a>
          <a href={isHome ? '#why-22' : '/#why-22'}>Why 22</a>
          <a href="/research">Compare</a>
          <a class="nav-github" href="https://github.com/22-factor-apps/22-factor-apps.github.io" rel="noopener noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-statement">
          <span class="footer-index">22 / F</span>
          <p>Build software that can be understood, trusted, changed, and operated.</p>
        </div>

        <div class="footer-links">
          <div>
            <h2>Read</h2>
            <a href="/#factors">All factors</a>
            <a href="/research">Comparative research</a>
            <a href="/retired">Retired factors</a>
          </div>
          <div>
            <h2>Lineage</h2>
            <a href="https://12factor.net/" rel="noopener noreferrer">The original twelve ↗</a>
            <a href="https://www.oreilly.com/library/view/beyond-the-twelve-factor/9781492042631/" rel="noopener noreferrer">Beyond the Twelve-Factor App ↗</a>
            <a href="https://github.com/22-factor-apps/22-factor-apps.github.io" rel="noopener noreferrer">Source and discussion ↗</a>
          </div>
        </div>
      </div>

      <div class="footer-legal">
        <span>© 2026 The 22-Factor Apps Authors · MIT</span>
        <span>Inspired by 12factor.net · Not affiliated with Heroku or Salesforce</span>
      </div>
    </footer>
  </body>
</html>
