---
import Base from '../layouts/Base.astro';

const editorialTests = [
  {
    number: '01',
    title: 'Broadly applicable',
    body: 'The pressure must matter across languages, vendors, and workload shapes. A useful specialty rule can remain an overlay instead of becoming a universal factor.',
  },
  {
    number: '02',
    title: 'Architecturally load-bearing',
    body: 'Ignoring it must create a recurring production failure, unsafe default, or lifecycle dead end—not merely miss a fashionable tool or preferred implementation.',
  },
  {
    number: '03',
    title: 'Distinct enough',
    body: 'The factor needs its own design decision and evidence. Related concerns can overlap, but two labels must not reward the same work twice.',
  },
  {
    number: '04',
    title: 'Falsifiable in practice',
    body: 'A team must be able to fail a litmus test. Aspirations without an observable boundary, owner, or decision do not qualify as commandments.',
  },
  {
    number: '05',
    title: 'Durable under change',
    body: 'The wording names intent and system behavior. Ports, vendors, orchestration products, and deployment fashions may change without invalidating the rule.',
  },
];

const comparisons = [
  {
    number: '01',
    label: 'Direct lineage · 2011–2016',
    title: 'Twelve-Factor + Fifteen-Factor',
    focus: 'Portable, deployable cloud applications',
    overlap: 'I–XIII',
    borrowed: 'The durable original ten remain the foundation. Kevin Hoffman’s API-first, telemetry, and authentication/authorization additions become Contract-First Interfaces, Observability & SLOs, and Secure by Design.',
    contrast: 'This guide retires transport-specific port binding and promotes logs into a complete signal-and-decision model. It broadens API-first beyond HTTP and broadens identity into the full secure-development lifecycle.',
    sources: [
      { label: 'Original Twelve-Factor App', href: 'https://12factor.net/' },
      { label: 'Beyond the Twelve-Factor App', href: 'https://www.oreilly.com/library/view/beyond-the-twelve-factor/9781492042631/' },
      { label: 'IBM’s Fifteen-Factor review', href: 'https://developer.ibm.com/articles/15-factor-applications/' },
    ],
  },
  {
    number: '02',
    label: 'Runtime architecture · 2014',
    title: 'The Reactive Manifesto',
    focus: 'Responsive, resilient, elastic, message-driven systems',
    overlap: 'VII, XIII, XV',
    borrowed: 'Bounded response time, backpressure, isolation, elasticity, and failure containment sharpen Concurrency, Observability & SLOs, and Resilience & Fault Containment.',
    contrast: 'Message-driven architecture is a strong pattern, not a universal commandment for every CLI, embedded workload, batch process, or local application. The Twenty-Two-Factor set specifies outcomes and bounds without prescribing one communication model.',
    sources: [
      { label: 'The Reactive Manifesto', href: 'https://www.reactivemanifesto.org/' },
    ],
  },
  {
    number: '03',
    label: 'Reliability · SRE / Chaos',
    title: 'SRE + Principles of Chaos Engineering',
    focus: 'Measurable reliability under realistic disturbance',
    overlap: 'VIII, XIII, XV, XVIII',
    borrowed: 'SLIs, SLOs, error budgets, release safety, production readiness, steady-state hypotheses, realistic failure injection, and bounded experiments make reliability claims testable.',
    contrast: 'SRE is an operating discipline and Chaos is an empirical practice; neither is reduced here to a checkbox. Their evidence loops support several factors rather than becoming a vague “test more” commandment.',
    sources: [
      { label: 'Google SRE books', href: 'https://sre.google/books/' },
      { label: 'Principles of Chaos Engineering', href: 'https://principlesofchaos.org/' },
    ],
  },
  {
    number: '04',
    label: 'Delivery research · DORA',
    title: 'DORA Capabilities',
    focus: 'Delivery performance, organizational outcomes, and wellbeing',
    overlap: 'I, V, IX, XVIII, XIX',
    borrowed: 'Version control, continuous delivery, small changes, loosely coupled teams, monitoring, database change management, maintainability, customer feedback, and sustainable pace reinforce the delivery and feedback disciplines.',
    contrast: 'DORA reports empirically associated capabilities and outcomes; this guide states architectural obligations. It deliberately avoids turning deployment frequency or any single metric into a universal target detached from context.',
    sources: [
      { label: 'DORA capabilities catalog', href: 'https://dora.dev/capabilities/' },
      { label: 'DORA on continuous delivery', href: 'https://dora.dev/capabilities/continuous-delivery/' },
    ],
  },
  {
    number: '05',
    label: 'Architecture review · Cloud providers',
    title: 'Well-Architected Frameworks',
    focus: 'Cross-pillar workload quality and explicit trade-offs',
    overlap: 'VII, XII–XVIII, XXII',
    borrowed: 'Operational excellence, security, reliability, performance efficiency, cost, and sustainability confirm that production quality is multi-dimensional and that improving one dimension can tax another.',
    contrast: 'Provider frameworks are deep review catalogs. This guide is a shorter, vendor-neutral set of application pressures. Performance and cost remain cross-cutting constraints through Concurrency, SLOs, Resilience, delivery, and Sustainability rather than context-free universal factors.',
    sources: [
      { label: 'AWS Well-Architected pillars', href: 'https://docs.aws.amazon.com/wellarchitected/latest/framework/the-pillars-of-the-framework.html' },
      { label: 'Google Cloud Well-Architected', href: 'https://cloud.google.com/architecture/framework' },
      { label: 'Azure Well-Architected', href: 'https://learn.microsoft.com/azure/well-architected/' },
    ],
  },
  {
    number: '06',
    label: 'Cloud-native systems · CNCF / GitOps',
    title: 'CNCF Architecture + OpenGitOps',
    focus: 'Portable, interoperable, observable, resilient desired state',
    overlap: 'IV, XI, XIII, XV, XVII',
    borrowed: 'Interoperable contracts, vendor-neutral telemetry, declarative versioned state, automatic reconciliation, and continuous drift detection shape the application and infrastructure boundaries.',
    contrast: 'Cloud native is one deployment context, not the definition of modern software. The commandments also apply to mobile, desktop, edge, embedded, local-first, and regulated systems where Kubernetes or GitOps may be the wrong implementation.',
    sources: [
      { label: 'CNCF Cloud Native Architecture', href: 'https://architecture.cncf.io/' },
      { label: 'OpenGitOps principles', href: 'https://opengitops.dev/' },
    ],
  },
  {
    number: '07',
    label: 'Security lifecycle · OWASP / NIST / CISA',
    title: 'SAMM + SSDF + Secure by Design',
    focus: 'Security ownership from requirements through operations',
    overlap: 'XII, XIV, XVI, XXI',
    borrowed: 'Threat modeling, security requirements, safe defaults, verification, vulnerability response, supply-chain evidence, memory-safe implementation, and responsibility for customer security outcomes broaden the earlier identity-only rule.',
    contrast: 'SAMM is a maturity model and SSDF is a practice catalog. Factor XII is the compressed architectural commandment; it does not replace either framework, a domain threat model, or a formal safety case.',
    sources: [
      { label: 'OWASP SAMM', href: 'https://owaspsamm.org/model/' },
      { label: 'NIST Secure Software Development Framework', href: 'https://csrc.nist.gov/pubs/sp/800/218/final' },
      { label: 'CISA Secure by Design', href: 'https://www.cisa.gov/securebydesign' },
    ],
  },
  {
    number: '08',
    label: 'People and change · 2001',
    title: 'Manifesto for Agile Software Development',
    focus: 'People, working software, collaboration, and response to change',
    overlap: 'IX, XI, XVIII–XIX',
    borrowed: 'Short feedback, working software, direct collaboration, and response to change reinforce representative testing, contract evolution, and progressive delivery.',
    contrast: 'The Agile Manifesto is about values for making software; this guide is about system properties and lifecycle evidence. Neither can substitute for the other, and process labels do not prove architectural fitness.',
    sources: [
      { label: 'Manifesto for Agile Software Development', href: 'https://agilemanifesto.org/' },
      { label: 'The twelve Agile principles', href: 'https://agilemanifesto.org/principles.html' },
    ],
  },
  {
    number: '09',
    label: 'User agency · 2019',
    title: 'Local-first Software',
    focus: 'Speed, offline use, longevity, privacy, and user control',
    overlap: 'VI, XI, XV, XVI, XIX',
    borrowed: 'Data Lifecycle & Privacy now treats portable export, durable formats, offline usefulness, and provider exit as practical agency—not just compliance workflows.',
    contrast: 'Local-first is compelling for user-authored and collaborative data, but central authority is appropriate for banking, marketplaces, and other domains. The factor requires agency and lifecycle control without prescribing CRDTs or device-primary storage.',
    sources: [
      { label: 'Ink & Switch: Local-first Software', href: 'https://www.inkandswitch.com/essay/local-first/' },
    ],
  },
  {
    number: '10',
    label: 'Responsible technology · Sustainability',
    title: 'Sustainable Web + Green Software + FinOps',
    focus: 'Efficient, open, honest, resilient technology within physical limits',
    overlap: 'XVI, XXII',
    borrowed: 'Useful-work units, energy and hardware efficiency, carbon awareness, cost evidence, accessibility, honesty, and explicit trade-offs connect resource use to value and harm.',
    contrast: 'Cost remains a cross-cutting design constraint rather than a standalone factor, and price is not a physical-impact signal. “Renewable” and offsets do not excuse waste, while efficiency work must not export harm into accessibility, privacy, labor, or reliability.',
    sources: [
      { label: 'Sustainable Web Manifesto', href: 'https://www.sustainablewebmanifesto.com/' },
      { label: 'Green Software principles', href: 'https://learn.greensoftware.foundation/introduction/' },
      { label: 'FinOps principles', href: 'https://www.finops.org/framework/principles/' },
    ],
  },
  {
    number: '11',
    label: 'Specialized extension · AI',
    title: 'Google’s Sixteen-Factor AI Extension',
    focus: 'Prompts, model state, non-deterministic quality, and AI trust',
    overlap: 'I, II, VI, XII–XVI, XIX–XXII',
    borrowed: 'Prompts, context logic, behavioral specifications, models, evaluation sets, and guardrails are first-class versioned inputs. Quality and tool-use safety must be measured as product behavior, not inferred from HTTP success.',
    contrast: 'AI introduces distinct hazards, but they fit the universal rules: prompts and specs are source, models are dependencies, memory is state, evaluations are SLO evidence, tools require least privilege, and critical workflows need explicit states and guarded effects. AI-specific standards remain an overlay.',
    sources: [
      { label: 'From Twelve to Sixteen-Factor AI Apps', href: 'https://cloud.google.com/transform/from-the-twelve-to-sixteen-factor-app' },
    ],
  },
  {
    number: '12',
    label: 'Correctness by construction · Formal / language safety',
    title: 'Formal Methods + Memory-Safe Languages',
    focus: 'Explicit system behavior and elimination of preventable defect classes',
    overlap: 'XX–XXI',
    borrowed: 'State-machine specifications, safety and liveness properties, immutable functional cores, typed errors, exhaustive matching, memory safety, explicit absence, and isolated unsafe boundaries turn reviewer assumptions into checkable constraints.',
    contrast: 'Types and safe languages prevent important classes of failure but do not prove requirements, authorization, concurrency, or domain correctness. Formal rigor is proportional to risk, and every model must state its assumptions and connection to implementation.',
    sources: [
      { label: 'Leslie Lamport: A High-Level View of TLA+', href: 'https://lamport.azurewebsites.net/tla/high-level-view.html' },
      { label: 'Rust: exhaustive matching', href: 'https://doc.rust-lang.org/stable/book/ch06-02-match.html' },
      { label: 'Rust: Option instead of null', href: 'https://doc.rust-lang.org/book/ch06-01-defining-an-enum.html' },
      { label: 'CISA: Memory Safe Roadmaps', href: 'https://www.cisa.gov/resources-tools/resources/case-memory-safe-roadmaps' },
    ],
  },
];
---

<Base
  title="Comparative Research — The Twenty-Two-Factor App"
  description="How the Twenty-Two-Factor App compares with the Fifteen-Factor App, Reactive Manifesto, SRE, Chaos, DORA, Well-Architected frameworks, secure-by-design guidance, formal methods, memory-safe languages, Agile, Local-first, sustainable software, and AI extensions."
>
  <section class="content-page research-page">
    <header class="content-page-header">
      <div>
        <p class="section-label">Comparative research · 2026.3</p>
        <h1>Borrow the pressure.<br />Reject the costume.</h1>
      </div>
      <p>
        A credible manifesto should show its competitors, not merely cite its ancestor.
        This comparison asks what each body of work optimizes, what the Twenty-Two-
        Factor App adopts, and where it deliberately refuses a universal claim.
      </p>
    </header>

    <section class="editorial-method" aria-labelledby="selection-test-title">
      <div class="research-section-heading">
        <p class="section-label">01 · The selection test</p>
        <h2 id="selection-test-title">A factor must earn<br />the number.</h2>
        <p>
          Twenty-two is editorial compression, not numerology. A practice enters the
          set only when it passes all five tests; otherwise it remains a useful pattern,
          specialty overlay, standard, or implementation guide.
        </p>
      </div>

      <div class="editorial-tests">
        {editorialTests.map((test) => (
          <article>
            <span>{test.number}</span>
            <h3>{test.title}</h3>
            <p>{test.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="scope-boundary" id="revision-2026-3" aria-labelledby="revision-title">
      <p class="section-label">02 · Revision note</p>
      <h2 id="revision-title">Correctness earned<br />two explicit factors.</h2>
      <div>
        <p>
          Edition 2026.3 retires Outcome Ownership and Cost as Architecture as
          standalone universal factors. Ownership remains required wherever a
          commandment calls for evidence, authority, or follow-up; cost remains a
          constraint across capacity, observability, resilience, delivery, and
          sustainable operation.
        </p>
        <p>
          Their numbered slots now cover two harder-to-retrofit production blind
          spots: explicit formal state and functional decision logic, followed by
          memory-safe languages, total types, explicit absence, and contained unsafe
          interoperability. Earlier factor URLs redirect here so the revision remains
          reviewable instead of silently rewriting history.
        </p>
      </div>
    </section>

    <section class="comparison-section" aria-labelledby="comparison-title">
      <div class="research-section-heading comparison-heading">
        <p class="section-label">03 · Compare and contrast</p>
        <h2 id="comparison-title">Twelve lenses.<br />One compressed set.</h2>
        <p>
          “Overlap” names the factors most directly pressured by each source; it does
          not claim equivalence. The distinctions matter as much as the borrowings.
        </p>
      </div>

      <div class="comparison-list">
        {comparisons.map((item) => (
          <article class="comparison-entry">
            <div class="comparison-entry-meta">
              <span>{item.number}</span>
              {item.label}
            </div>
            <div class="comparison-entry-main">
              <h3>{item.title}</h3>
              <dl class="comparison-facts">
                <div>
                  <dt>Optimizes for</dt>
                  <dd>{item.focus}</dd>
                </div>
                <div>
                  <dt>Strongest overlap</dt>
                  <dd>{item.overlap}</dd>
                </div>
              </dl>
              <div class="comparison-argument">
                <div>
                  <h4>What this guide borrows</h4>
                  <p>{item.borrowed}</p>
                </div>
                <div>
                  <h4>Where this guide differs</h4>
                  <p>{item.contrast}</p>
                </div>
              </div>
              <div class="source-links" aria-label={`Sources for ${item.title}`}>
                {item.sources.map((source) => (
                  <a href={source.href} rel="noopener noreferrer">{source.label} ↗</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="scope-boundary" aria-labelledby="scope-title">
      <p class="section-label">04 · Honest boundary</p>
      <h2 id="scope-title">A field guide is not<br />a complete profession.</h2>
      <div>
        <p>
          These commandments do not replace user research, accessibility standards,
          secure-development maturity models, domain regulation, formal safety cases,
          incident command, engineering management, or specialty guidance for AI,
          medical, financial, embedded, and other high-consequence systems.
        </p>
        <p>
          Their job is narrower: expose the cross-cutting architectural pressures that
          are easiest to postpone and hardest to retrofit, state a boundary against
          cargo culting, and leave every claim open to evidence and revision.
        </p>
      </div>
      <a class="button button-primary" href="/#factors">Read the 22 commandments <span aria-hidden="true">→</span></a>
    </section>
  </section>
</Base>
