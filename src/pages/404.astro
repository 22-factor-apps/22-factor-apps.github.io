---
import Base from '../layouts/Base.astro';
---

<Base title="404 — The Twenty-Two-Factor App" description="Page not found.">
  <section class="hero">
    <div class="watermark" aria-hidden="true">404</div>
    <p class="kicker">Factor not found</p>
    <h1>There are only <span class="n22">twenty&#8209;two</span>.</h1>
    <p class="lede">
      Whatever you were looking for isn't one of them — the deploy you want is at a
      different URL. Roll back to safety:
    </p>
    <div class="actions">
      <a class="btn primary" href="/">Back to the factors</a>
      <a class="btn" href="/factors/codebase">Start at Factor I</a>
    </div>
  </section>
</Base>
