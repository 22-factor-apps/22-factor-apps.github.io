---
import Base from '../layouts/Base.astro';
---

<Base title="404 — The Twenty-Two-Factor App" description="That page is not in this field guide.">
  <section class="not-found">
    <div class="not-found-inner">
      <span aria-hidden="true">404</span>
      <h1>Factor not found.</h1>
      <p>
        The system failed safely, at least. Return to the field guide and choose one
        of the twenty-two routes we actually know how to operate.
      </p>
      <a class="button button-primary" href="/#factors">Browse all factors <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
